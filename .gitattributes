# Keep Unix line endings for anything that runs inside Linux containers or servers,
# even when the repo is checked out on Windows (core.autocrlf=true).
* text=auto
gradlew text eol=lf
*.sh text eol=lf
Dockerfile text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
Caddyfile text eol=lf
*.bat text eol=crlf
*.jar binary
*.jpg binary
*.png binary
*.pdf binary
