# Where the app finds the backend. Copy to .env.local and adjust.
#  - Web in the same computer's browser:    http://localhost:8080
#  - Android emulator:                      http://10.0.2.2:8080
#  - Phone with Expo Go (same Wi-Fi):       http://<your computer's IP>:8080
EXPO_PUBLIC_API_URL=http://localhost:8080
