# Copy to .env on the server (chmod 600). Never commit the real .env.
HAWKS_DOMAIN=api.example.org
POSTGRES_PASSWORD=change-me-to-a-long-random-string
# Optional: pin a specific image tag instead of latest
# HAWKS_IMAGE=ghcr.io/josedgefield/cricket-platform-hawks/backend:sha-abc1234
# Public key (age1...) that encrypts backups. Keep the private key OFF the server.
BACKUP_AGE_RECIPIENT=age1replace-with-your-public-key
# OCI Object Storage bucket for backups (Always Free includes 20 GB)
BACKUP_BUCKET=hawks-backups
