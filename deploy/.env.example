# Copy to .env on the server (chmod 600). Never commit the real .env.
HAWKS_DOMAIN=api.example.org
POSTGRES_PASSWORD=change-me-to-a-long-random-string
# Optional: pin a specific image tag instead of latest
# HAWKS_IMAGE=ghcr.io/josedgefield/cricket-platform-hawks/backend:sha-abc1234
# Public key (age1...) that encrypts backups. Keep the private key OFF the server.
BACKUP_AGE_RECIPIENT=age1replace-with-your-public-key
# OCI Object Storage bucket for backups (Always Free includes 20 GB)
BACKUP_BUCKET=hawks-backups

# --- Sign-in and email ---
# Where the web app runs; links in invite and reset emails point here.
HAWKS_APP_BASE_URL=https://app.example.org
# Browsers may call the API only from these origins (usually the same as above).
HAWKS_CORS_ALLOWED_ORIGINS=https://app.example.org
# The first superuser (support). On first start, if no superuser exists, they get an invite.
HAWKS_BOOTSTRAP_SUPERUSER_EMAIL=you@example.org
HAWKS_BOOTSTRAP_SUPERUSER_NAME=Your Name
# Any SMTP provider, e.g. Brevo (smtp-relay.brevo.com, port 587). Needs a domain you own.
HAWKS_MAIL_FROM=Hawks CC <admin@example.org>
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USERNAME=replace-me
SMTP_PASSWORD=replace-me
